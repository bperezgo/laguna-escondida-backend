PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=laguna_escondida
DB_SSLMODE=disable
ELECTRONIC_INVOICE_URL=your_url_here
ELECTRONIC_INVOICE_USER=your_user_here
ELECTRONIC_INVOICE_PASSWORD=your_password_here
ADMIN_API_KEY=admin-key
JWT_SECRET=jwt-secret
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1        # any value works for MinIO; keep it set (config requires it)
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET=minioadmin
STORAGE_BUCKET=laguna-escondida
ORGANIZATION_ID=

# Observability (off by default; the ECS cloud task sets these). When OBSERVABILITY_ENABLED
# is false the OTLP exporters stay off and only the /metrics listener runs, so local dev /
# docker-compose boots with no collector present.
OBSERVABILITY_ENABLED=false
OTEL_SERVICE_NAME=laguna-backend
ENVIRONMENT=dev
SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_PORT=9090