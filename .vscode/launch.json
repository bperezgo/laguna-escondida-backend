{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Launch Server (Debug)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/cloud",
      "envFile": "${workspaceFolder}/backend/.env",
      "args": [],
      "showLog": true,
      "trace": "verbose",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Backend: Attach to Process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": 0
    },
    {
      "name": "Backend: Debug acceptance sync tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/backend/test/acceptance/sync",
      "env": {
        "RUN_ACCEPTANCE_TESTS": "true"
      },
      "args": [
        "-test.v"
      ]
    },
    {
      "name": "Frontend: Debug Next.js (Frontend + API Routes)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:debug"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Frontend: Debug Next.js - Attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": true
    }
  ]
}
