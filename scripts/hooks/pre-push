#!/bin/bash

# Pre-push hook for laguna-escondida-backend
# Runs linting and tests before allowing push

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Running pre-push checks...${NC}"
echo ""

# Get the root directory of the git repository
ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

# Run linter
echo -e "${YELLOW}📝 Running linter...${NC}"
if ! make lint; then
    echo -e "${RED}❌ Linting failed! Please fix the issues above before pushing.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Linting passed${NC}"
echo ""

# Run tests
echo -e "${YELLOW}🧪 Running tests...${NC}"
if ! make test; then
    echo -e "${RED}❌ Tests failed! Please fix the failing tests before pushing.${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Tests passed${NC}"
echo ""

echo -e "${GREEN}🚀 All checks passed! Pushing...${NC}"
exit 0

