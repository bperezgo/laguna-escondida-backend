# Backend address the lead form posts to (required: the build fails without it).
PUBLIC_API_BASE_URL=http://localhost:8080
# Where the site is served; used for canonical links and the sitemap.
PUBLIC_SITE_URL=https://kuenta.com
# Google Analytics 4 measurement id. Unset = the tag is not loaded.
PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel id. Unset = the pixel is not loaded.
PUBLIC_META_PIXEL_ID=
# WhatsApp number with country code and digits only, e.g. 573001234567. Unset = the WhatsApp action is hidden.
PUBLIC_WHATSAPP_NUMBER=
# Legal name of whoever answers for the data (privacy policy). Unset = the product name.
PUBLIC_LEGAL_NAME=
# Where people send data requests (privacy policy). Unset = WhatsApp only, if configured.
PUBLIC_PRIVACY_EMAIL=

# The app's signup page, e.g. https://app.kuenta.co/registro. Unset hides the "Prueba 14 días" call to action; set it once signup opens.
PUBLIC_SIGNUP_URL=
