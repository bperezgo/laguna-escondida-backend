---
import { Image } from "astro:assets";

import { findShot } from "../lib/product-shots.ts";

interface Props {
  name: string;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { name, alt, class: className, loading = "lazy" } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/screens/*.{png,jpg,webp}", { eager: true });
const shot = findShot(shots, name).default;
---

<figure class={className}>
  <Image
    src={shot}
    alt={alt}
    loading={loading}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 1024px) 64rem, 100vw"
    class="border-line bg-surface w-full rounded-2xl border"
  />
</figure>
