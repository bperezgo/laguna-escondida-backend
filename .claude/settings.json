{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt -l *)",
      "Bash(make lint *)",
      "Bash(make test *)",
      "Bash(make test-acceptance *)",
      "Bash(make test-ci *)",
      "Bash(make generate-mocks *)",
      "Bash(make regenerate-mocks *)",
      "Bash(RUN_ACCEPTANCE_TESTS=true go test *)"
    ],
    "ask": [
      "Edit(**/*_test.go)",
      "Write(**/*_test.go)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./pem/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests-green-gate.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\""
          }
        ]
      }
    ]
  }
}
